{
  "compilerOptions": {
    "paths": {
			"@app/*": [
				"src/*"
			],
			"@config/*": [
				"src/config/*"
			],
			"@infra/*": [
				"src/infra/*"
			],
			"@errors/*": [
				"src/infra/common/errors/*"
			],
			"@database/*": [
				"src/database/*"
			],
			"@decorators/*":[
				"src/decorators/*"
			],
			"@common/*": [
				"src/common/*"
			],
		}
  }
}
