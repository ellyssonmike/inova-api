generator client {
  provider = "prisma-client"
  output   = "./runtime"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  password      String
  accessToken   String?     @unique
  lastLoginAt   DateTime?
  status        UserStatus  @default(active)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum UserStatus {
  active
  inactive
  suspended
}